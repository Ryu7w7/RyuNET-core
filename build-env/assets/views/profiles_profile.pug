extends _layout.pug

block head
  meta(property="og:site_name" content="RyuNET")
  meta(property="og:title" content=`${profile.name} · player info`)
  meta(property="og:description" content=ogDescription)
  meta(property="og:image" content=ogImage)
  meta(name="theme-color" content="#00d1b2")
  meta(name="twitter:card" content="summary")


  style.
    .profile-header {
      position: relative;
      margin-bottom: 3rem;
      border-radius: 8px;
      overflow: hidden;
      background-color: #2a2a2a;
    }
    .profile-banner {
      height: 280px;
      background-image: url('#{profile.bannerUrl ? "/uploads/" + profile.bannerUrl : "/static/img/default-banner.png"}');
      background-size: cover;
      background-position: center;
      position: relative;
    }
    /* Score Modal Custom Styles */
    #score-detail-modal .modal-content { background: transparent; overflow: visible; }
    .score-modal-content { font-family: 'Outfit', sans-serif, system-ui; background: rgba(13, 13, 20, 0.97); border-radius: 16px; box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 20px 60px rgba(0,0,0,0.8); color: #fff; padding: 0; overflow: hidden; width: 820px; max-width: 95vw; animation: modal-in 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }
    @keyframes modal-in { from { transform: scale(0.85) translateY(20px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
    .score-header { padding: 20px 24px 16px; position: relative; background: linear-gradient(135deg, #1c1c2e 0%, #12121e 100%); border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 16px; }
    .score-header-jacket { width: 72px; height: 72px; border-radius: 8px; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(255,255,255,0.12); background: #111; }
    .score-header-text { flex: 1; min-width: 0; }
    .score-header h2 { margin: 0 0 6px 0; font-size: 24px; font-weight: 800; letter-spacing: -0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: #fff; }
    .score-subtitle { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
    .score-played-by { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
    .score-played-by-avatar { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.2); flex-shrink: 0; }
    .score-played-by-text { font-size: 12px; color: rgba(255,255,255,0.45); font-weight: 500; }
    .score-played-by-name { font-size: 12px; color: rgba(255,255,255,0.8); font-weight: 700; margin-left: 2px; }
    .diff-badge { padding: 3px 12px; border-radius: 4px; font-weight: 700; font-size: 13px; letter-spacing: 1px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-transform: uppercase; }
    .level-badge { padding: 3px 10px; border-radius: 4px; font-weight: 800; font-size: 14px; background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.55); border: 1px solid rgba(255,255,255,0.1); letter-spacing: 0.5px; }
    .score-body { display: flex; padding: 28px 24px 28px 20px; gap: 20px; position: relative; background: linear-gradient(180deg, #0f0f1a 0%, #0a0a12 100%); align-items: center; overflow: visible; }
    .score-rank-container { flex: 0 0 160px; min-width: 160px; display: flex; justify-content: center; align-items: center; position: relative; padding: 14px 10px; overflow: visible; }
    .score-rank-container::before { content: ''; position: absolute; width: 140px; height: 140px; border-radius: 50%; background: var(--rank-color, rgba(255, 120, 0, 0.2)); filter: blur(35px); z-index: 0; }
    #modal-rank { font-size: 90px; font-weight: 900; font-style: italic; line-height: 1.3; padding: 4px 10px; position: relative; z-index: 1; background: var(--rank-gradient, linear-gradient(180deg, #ffb84d 0%, #ff6600 100%)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px var(--rank-shadow, rgba(255,102,0,0.5))); user-select: none; white-space: nowrap; display: inline-block; }
    #modal-rank[data-grade="S"] { --rank-gradient: linear-gradient(180deg, #ffe066 0%, #ffaa00 100%); --rank-shadow: rgba(255,170,0,0.6); --rank-color: rgba(255,170,0,0.2); font-size: 92px; }
    #modal-rank[data-grade="AAA+"] { --rank-gradient: linear-gradient(180deg, #ff88cc 0%, #cc44aa 100%); --rank-shadow: rgba(200,50,150,0.6); --rank-color: rgba(200,50,150,0.2); font-size: 50px; }
    #modal-rank[data-grade="AAA"] { --rank-gradient: linear-gradient(180deg, #bb88ff 0%, #7733cc 100%); --rank-shadow: rgba(100,50,200,0.6); --rank-color: rgba(100,50,200,0.2); font-size: 64px; }
    #modal-rank[data-grade="AA+"] { --rank-gradient: linear-gradient(180deg, #66aaff 0%, #2255cc 100%); --rank-shadow: rgba(30,80,200,0.6); --rank-color: rgba(30,80,200,0.2); font-size: 58px; }
    #modal-rank[data-grade="AA"] { --rank-gradient: linear-gradient(180deg, #66aaff 0%, #2255cc 100%); --rank-shadow: rgba(30,80,200,0.6); --rank-color: rgba(30,80,200,0.2); font-size: 74px; }
    #modal-rank[data-grade="A+"] { --rank-gradient: linear-gradient(180deg, #66ffdd 0%, #00aa88 100%); --rank-shadow: rgba(0,150,100,0.5); --rank-color: rgba(0,150,100,0.2); font-size: 68px; }
    #modal-rank[data-grade="A"] { --rank-gradient: linear-gradient(180deg, #66ffdd 0%, #00aa88 100%); --rank-shadow: rgba(0,150,100,0.5); --rank-color: rgba(0,150,100,0.2); font-size: 86px; }
    .score-stats { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 6px; }
    .score-number { font-size: 58px; font-weight: 200; letter-spacing: -2px; line-height: 1; font-variant-numeric: tabular-nums; }
    .score-meta-row { display: flex; gap: 20px; margin-top: 8px; }
    .score-meta-item { display: flex; flex-direction: column; gap: 2px; }
    .score-meta-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); font-weight: 600; }
    .score-meta-value { font-size: 22px; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
    #modal-maxchain { color: #44ffcc; }
    #modal-exscore { color: #ffcc44; }
    .score-medal-row { margin-top: 10px; }
    #modal-medal { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); }
    .judgements-container { flex: 0 0 220px; background: rgba(0,0,0,0.4); border-radius: 10px; padding: 18px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; gap: 14px; }
    .judgements-title { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 8px; margin-bottom: 2px; }
    .judgement-row { display: flex; align-items: center; gap: 8px; }
    .j-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .j-label { flex: 1; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; opacity: 0.85; }
    .j-value { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; min-width: 55px; }
    .j-sub-row { display: flex; justify-content: flex-end; gap: 12px; font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 600; margin-top: -8px; padding-right: 2px; }
    .j-sub-item { display: flex; align-items: center; gap: 4px; }
    .j-sub-item .arrow-early { color: #44bbff; }
    .j-sub-item .arrow-late { color: #ff8844; }
    .j-row-scrit .j-dot { background: #ffe600; }
    .j-row-scrit .j-label, .j-row-scrit .j-value { color: #ffe600; }
    .j-row-crit .j-dot { background: #ffaa00; }
    .j-row-crit .j-label, .j-row-crit .j-value { color: #ffaa00; }
    .j-row-near .j-dot { background: #44ffcc; }
    .j-row-near .j-label, .j-row-near .j-value { color: #44ffcc; }
    .j-row-error .j-dot { background: #ff3344; }
    .j-row-error .j-label, .j-row-error .j-value { color: #ff3344; }
    .score-card, .notification li { transition: transform 0.15s ease, background-color 0.15s ease; cursor: pointer !important; }
    .score-card:hover, .notification li:hover { transform: translateY(-2px); filter: brightness(1.1); }
    .media-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.2s;
      cursor: pointer;
      font-weight: bold;
      font-size: 1.1rem;
    }
    .profile-banner:hover .media-overlay, .profile-avatar:hover .media-overlay {
      opacity: 1;
    }
    .hidden-file-input {
      display: none;
    }
    .profile-info-bar {
      background-color: #1a1a1a;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      min-height: 80px;
    }
    .profile-avatar {
      position: absolute;
      bottom: 20px;
      left: 30px;
      border: 4px solid #1a1a1a;
      border-radius: 16px;
      background-color: #fff;
      overflow: hidden;
      width: 150px;
      height: 150px;
      z-index: 10;
    }
    .profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .profile-name-section {
      margin-left: 190px; /* Avatar width + offset */
      flex-grow: 1;
    }
    .profile-name {
      font-size: 1.5rem;
      font-weight: bold;
      color: #fff;
      margin-bottom: 0.25rem;
    }
    .stats-box {
      background-color: #242424;
      border-radius: 8px;
      padding: 1.5rem;
      height: 100%;
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
    }
    .stat-label {
      color: #aaa;
    }
    .stat-value {
      font-weight: bold;
      color: #fff;
    }
    .rank-display {
      font-size: 2rem;
      font-weight: bold;
      color: #f1c40f;
    }
    .profile-bio-section {
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
    }
    .profile-bio-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #888;
      margin-bottom: 0.4rem;
    }
    .profile-bio-text {
      color: #ddd;
      font-size: 1rem;
      line-height: 1.75;
      /* Auto-expand: no fixed height, grows with content up to max */
      min-height: 3em;
      max-height: 22em;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: rgba(255,255,255,0.15) transparent;
    }
    .profile-bio-text p { margin-bottom: 0.6em; }
    .profile-bio-text p:last-child { margin-bottom: 0; }
    .profile-bio-text h1, .profile-bio-text h2, .profile-bio-text h3 { color: #fff; font-weight: 700; margin: 0.8em 0 0.4em; }
    .profile-bio-text h1 { font-size: 1.4rem; }
    .profile-bio-text h2 { font-size: 1.2rem; }
    .profile-bio-text h3 { font-size: 1.05rem; }
    .profile-bio-text strong { color: #fff; }
    .profile-bio-text em { color: #ccc; }
    .profile-bio-text a { color: #66c2ff; text-decoration: underline; }
    .profile-bio-text ul, .profile-bio-text ol { padding-left: 1.5em; margin-bottom: 0.5em; }
    .profile-bio-text li { margin-bottom: 0.2em; }
    .profile-bio-text code { background: rgba(255,255,255,0.08); border-radius: 4px; padding: 1px 5px; font-family: monospace; font-size: 0.9em; }
    .profile-bio-text blockquote { border-left: 3px solid rgba(255,255,255,0.2); padding-left: 1em; color: #aaa; margin: 0.5em 0; }
    /* Markdown toolbar */
    .bio-toolbar { display: flex; gap: 4px; flex-wrap: wrap; padding: 6px 8px; background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1); border-bottom: none; border-radius: 8px 8px 0 0; }
    .bio-toolbar-btn { background: none; border: 1px solid transparent; color: #aaa; border-radius: 5px; width: 30px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; cursor: pointer; transition: all 0.15s; font-family: serif; font-weight: bold; }
    .bio-toolbar-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); color: #fff; }
    .bio-toolbar-sep { width: 1px; background: rgba(255,255,255,0.1); margin: 3px 2px; }
    .bio-textarea-wrap textarea { border-radius: 0 0 8px 8px !important; border-top: none !important; resize: none; min-height: 120px; max-height: 400px; overflow-y: auto; }
    .stats-horizontal { display: flex; justify-content: space-around; background: #222; border-radius: 12px; padding: 20px 10px; margin-bottom: 2rem; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.2); }
    .stat-item { display: flex; flex-direction: column; align-items: center; }
    .stat-label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
    .stat-val { font-size: 1.75rem; font-weight: bold; color: #fff; }
    .stat-val.gold { color: #ffcc00; }
    .bio-edit-btn {
      background: rgba(255,255,255,0.1);
      border: none;
      color: #eee;
      border-radius: 16px;
      transition: background 0.2s;
    }
    .bio-edit-btn:hover {
      background: rgba(255,255,255,0.25);
      color: #fff;
    }
    .score-list { list-style: none; padding: 0; margin: 0; }
    .score-card { display: flex; align-items: center; background: #2c2c2c; border-radius: 12px; padding: 10px 16px; margin-bottom: 8px; transition: background 0.2s; border: 1px solid rgba(255,255,255,0.05); }
    .score-card:hover { background: #363636; border-color: rgba(255,255,255,0.1); }
    .score-jacket { width: 56px; height: 56px; border-radius: 8px; margin-right: 16px; object-fit: cover; background: #111; border: 1px solid rgba(255,255,255,0.1); }
    .score-info { flex: 1; display: flex; flex-direction: column; justify-content: center; overflow: hidden; text-align: left; }
    .score-title { font-weight: 600; color: #fff; font-size: 1.05rem; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .score-meta { display: flex; align-items: center; font-size: 0.8rem; color: #888; }
    .diff-badge { padding: 3px 8px; border-radius: 6px; font-weight: bold; font-size: 0.75rem; margin-right: 10px; background: #444; color: #fff; text-transform: uppercase; letter-spacing: 0.5px; }
    .score-stats { display: flex; align-items: center; gap: 24px; text-align: right; margin-left: auto; }
    .stat-col { display: flex; flex-direction: column; align-items: flex-end; min-width: 90px; }
    .score-main-stat { font-size: 1.25rem; font-weight: bold; color: #fff; }
    .score-main-stat.is-gold { color: #ffd700; }
    .score-sub-stat { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; }
    .score-date { font-size: 0.8rem; color: #aaa; margin-left: 24px; white-space: nowrap; width: 85px; text-align: right; }
    .show-more-container { text-align: center; margin-top: 15px; margin-bottom: 30px; }
    .show-more-btn { background: #333; border: 1px solid #444; color: #eee; padding: 8px 24px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; cursor: pointer; transition: all 0.2s ease; letter-spacing: 1px; }
    .show-more-btn:hover { background: #444; border-color: #555; color: #fff; transform: translateY(-1px); }
    .section-title { text-align: center; margin-bottom: 1.5rem !important; position: relative; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; font-size: 1.1rem; color: #fff; border-bottom: 2px solid #333; padding-bottom: 10px; }
    
    .clear-puc { border-left: 4px solid #ffd700 !important; }
    .clear-uc { border-left: 4px solid #ff4081 !important; }
    .clear-exc { border-left: 4px solid #00d1b2 !important; }
    .clear-comp { border-left: 4px solid #209cee !important; }
    
    .clear-fc { border-left: 4px solid #ffd700 !important; }
    .clear-exh { border-left: 4px solid #ff4081 !important; }
    .clear-hard { border-left: 4px solid #f00 !important; }
    .clear-clear { border-left: 4px solid #209cee !important; }
    .clear-easy { border-left: 4px solid #00d1b2 !important; }
    .clear-assist { border-left: 4px solid #b86bff !important; }
    .clear-fail { border-left: 4px solid #555 !important; }
    
    .tier-lustrous { background: linear-gradient(90deg, #ff8a00, #e52e71, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 900 !important; }
    .tier-radiant { color: #55ffff !important; font-weight: 800 !important; text-shadow: 0 0 8px rgba(85,255,255,0.4); }
    .tier-rhodium { color: #ff99cc !important; font-weight: 800 !important; }
    .tier-platinum { color: #00e5ff !important; font-weight: 800 !important; }
    .tier-gold { color: #ffd700 !important; font-weight: 700 !important; }
    .tier-silver { color: #c0c0c0 !important; font-weight: 600 !important; }
    .tier-bronze { color: #cd7f32 !important; font-weight: 600 !important; }
    .tier-iron { color: #a19d94 !important; font-weight: 600 !important; }
    
    .stats-horizontal { display: flex; justify-content: space-around; align-items: center; background: #242424; border-radius: 12px; padding: 25px 20px; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    .stat-item { text-align: center; flex: 1; }
    .stat-label { font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .stat-val { font-size: 2rem; font-weight: bold; color: #fff; }
    .stat-val.gold { color: #ffd700; }
    .pane-container { max-width: 900px; margin: 0 auto; }

    .profile-details-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; margin-top: 0.5rem; font-size: 0.82rem; color: #aaa; }
    .profile-detail-item { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
    .profile-detail-item a { color: #aaa; text-decoration: none; transition: color 0.2s; }
    .profile-detail-item a:hover { color: #fff; }
    .profile-detail-item .mdi { font-size: 1rem; }
    .edit-profile-btn { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #ccc; border-radius: 20px; padding: 4px 14px; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; letter-spacing: 0.5px; display: inline-flex; align-items: center; gap: 6px; }
    .edit-profile-btn:hover { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.3); color: #fff; }
    .ep-modal-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 1000; align-items: center; justify-content: center; }
    .ep-modal-backdrop.is-open { display: flex; }
    .ep-modal { background: #1e1e1e; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 2rem; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; position: relative; box-shadow: 0 20px 60px rgba(0,0,0,0.6); animation: ep-in 0.2s ease; }
    @keyframes ep-in { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: translateY(0); } }
    .ep-modal h2 { font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px; }
    .ep-field { margin-bottom: 1rem; }
    .ep-label { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: #888; margin-bottom: 5px; font-weight: 600; }
    .ep-input { width: 100%; background: #2a2a2a; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; padding: 8px 12px; font-size: 0.9rem; transition: border-color 0.2s; outline: none; }
    .ep-input:focus { border-color: rgba(255,255,255,0.35); }
    .ep-prefix { display: flex; align-items: center; background: #2a2a2a; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; overflow: hidden; }
    .ep-prefix-label { padding: 8px 10px; color: #666; font-size: 0.85rem; white-space: nowrap; border-right: 1px solid rgba(255,255,255,0.08); }
    .ep-prefix .ep-input { border: none; border-radius: 0; background: transparent; }
    .ep-divider { border: none; border-top: 1px solid rgba(255,255,255,0.07); margin: 1.2rem 0; }
    .ep-section-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px; color: #666; margin-bottom: 0.75rem; font-weight: 700; }
    .ep-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; color: #888; font-size: 1.4rem; cursor: pointer; line-height: 1; padding: 4px; border-radius: 50%; transition: color 0.2s; }
    .ep-close:hover { color: #fff; }
    .ep-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 1.5rem; }

block content
  - const getRankTier = (rank, total) => {
  -   if (!rank || !total) return '';
  -   if (rank <= 3) return 'tier-lustrous';
  -   if (rank <= 10) return 'tier-radiant';
  -   if (rank <= 25) return 'tier-rhodium';
  -   if (rank <= 50) return 'tier-platinum';
  -   const pct = rank / total;
  -   if (pct <= 0.20) return 'tier-gold';
  -   if (pct <= 0.40) return 'tier-silver';
  -   if (pct <= 0.70) return 'tier-bronze';
  -   return 'tier-iron';
  - }
  - let userTierClass = '';
  - if (sdvxRank && sdvxRank.globalRank) {
  -   userTierClass = getRankTier(sdvxRank.globalRank, sdvxRank.totalGlobal);
  - } else if (iidxRank && iidxRank.globalRank) {
