block scripts
  script.
    const JACKET_DUMMY = 'https://jackets.ryu7w7.xyz/sdvx/jk_dummy.png';
    const MODAL_PLAYER_NAME = '!{profile.name}';
    const MODAL_PLAYER_AVATAR = '!{profile.avatarUrl ? "/uploads/" + profile.avatarUrl : "/static/img/avatar.jpg"}';
    // jacketFallback MUST be defined before any <img> onerror fires.
    function jacketFallback(img) {
      // Try falling back: _4 -> _3 -> _2 -> _1 -> dummy
      // URL pattern: .../folderName/jk_XXXX_N.png
      const src = img.src;
      const m = src.match(/^(.*\/jk_(\d+)_)(\d+)\.png(.*)?$/);
      if (m) {
        const prefix = m[1];
        const current = parseInt(m[3], 10);
        if (current > 1) {
          img.onerror = function() { jacketFallback(img); };
          img.src = prefix + (current - 1) + '.png';
          return;
        }
      }
      img.onerror = null;
      img.src = JACKET_DUMMY;
    }
  script(type="text/javascript" src="/static/js/profile.js")
  script.
    function openEditProfile() {
      document.getElementById('ep-modal-backdrop').classList.add('is-open');
      document.documentElement.classList.add('is-clipped');
    }
    function closeEditProfile() {
      document.getElementById('ep-modal-backdrop').classList.remove('is-open');
      document.documentElement.classList.remove('is-clipped');
    }
    function closeEditProfileBackdrop(e) {
      if (e.target === document.getElementById('ep-modal-backdrop')) closeEditProfile();
    }

    function loadMoreScores(containerId, btnElement) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const hiddenItems = container.querySelectorAll('.score-card[style*="display: none"]');
      let count = 0;
      for (let i = 0; i < hiddenItems.length; i++) {
        if (count < 10) {
          hiddenItems[i].style.display = '';
          count++;
        } else {
          break;
        }
      }
      const remaining = container.querySelectorAll('.score-card[style*="display: none"]').length;
      if (remaining === 0) {
        btnElement.style.display = 'none';
      }
    }

    function toggleBioEdit() {
      const display = document.getElementById('bio-display');
      const form = document.getElementById('bio-edit-form');
      if (display.style.display === 'none') {
        display.style.display = 'block';
        form.style.display = 'none';
      } else {
        display.style.display = 'none';
        form.style.display = 'block';
      }
    }

    function switchTab(tab) {
      document.getElementById('tab-sdvx').classList.remove('is-active');
      document.getElementById('tab-iidx').classList.remove('is-active');
      document.getElementById('pane-sdvx').style.display = 'none';
      document.getElementById('pane-iidx').style.display = 'none';
      
      document.getElementById('tab-' + tab).classList.add('is-active');
      document.getElementById('pane-' + tab).style.display = '';
    }

    document.querySelectorAll('.jb-modal').forEach(function(el) {
      el.addEventListener('click', function(e) {
        var target = document.getElementById(e.currentTarget.getAttribute('data-target'));
        if (target) {
          target.classList.add('is-active');
          document.documentElement.classList.add('is-clipped');
        }
      });
    });
    document.querySelectorAll('.jb-modal-close').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.currentTarget.closest('.modal').classList.remove('is-active');
        document.documentElement.classList.remove('is-clipped');
      });
    });
    // ---- Markdown toolbar helpers ----
    function getBioTA() { return document.getElementById('bio-textarea'); }

    function bioInsert(before, after) {
      var ta = getBioTA(); if (!ta) return;
      var start = ta.selectionStart, end = ta.selectionEnd;
      var sel = ta.value.slice(start, end);
      var replacement = before + (sel || 'text') + after;
      ta.setRangeText(replacement, start, end, 'select');
      // Reposition cursor inside the wrapper
      ta.selectionStart = start + before.length;
      ta.selectionEnd = start + before.length + (sel || 'text').length;
      ta.focus();
      bioAutoResize(ta);
    }

    function bioInsertLine(prefix) {
      var ta = getBioTA(); if (!ta) return;
      var start = ta.selectionStart;
      // Find start of current line
      var lineStart = ta.value.lastIndexOf('\n', start - 1) + 1;
      ta.setRangeText(prefix, lineStart, lineStart, 'end');
      ta.focus();
      bioAutoResize(ta);
    }

    function bioInsertLink() {
      var ta = getBioTA(); if (!ta) return;
      var start = ta.selectionStart, end = ta.selectionEnd;
      var sel = ta.value.slice(start, end) || 'link text';
      var url = prompt('Enter URL:', 'https://');
      if (!url) return;
      var md = '[' + sel + '](' + url + ')';
      ta.setRangeText(md, start, end, 'end');
      ta.focus();
      bioAutoResize(ta);
    }

    function bioAutoResize(ta) {
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight, 400) + 'px';
    }

    // Auto-resize on load and input
    document.addEventListener('DOMContentLoaded', function() {
      var ta = getBioTA();
      if (ta) {
        ta.addEventListener('input', function() { bioAutoResize(ta); });
        bioAutoResize(ta);
      }
    });

    function openSdvxScoreModal(el) {
      try {
        var data = JSON.parse(el.getAttribute('data-play'));
        if (!data) return;

        document.getElementById('modal-songname').innerText = data.title || 'Song Name';
        document.getElementById('modal-diff').innerText = (data.diff || 'MXM').toUpperCase();
        
        var jacketEl = document.getElementById('modal-jacket');
        if (jacketEl) jacketEl.src = data.jacketUrl || '';
        var avatarEl = document.getElementById('modal-player-avatar');
        if (avatarEl) avatarEl.src = MODAL_PLAYER_AVATAR;
        var nameEl = document.getElementById('modal-player-name');
        if (nameEl) nameEl.innerText = MODAL_PLAYER_NAME;
        
        var gradeStr = getSdvxGradeText(data.score, data.grade);
        var rankEl = document.getElementById('modal-rank');
        rankEl.innerText = gradeStr;
        rankEl.setAttribute('data-grade', gradeStr);

        document.getElementById('modal-score').innerText = Number(data.score || 0).toLocaleString();
        document.getElementById('modal-exscore').innerText = Number(data.exscore || 0).toLocaleString();
        document.getElementById('modal-maxchain').innerText = Number(data.maxChain || 0).toLocaleString();
        document.getElementById('modal-scrit').innerText = Number(data.s_critical || 0).toLocaleString();
        document.getElementById('modal-crit').innerText = Number(data.critical || 0).toLocaleString();
        document.getElementById('modal-near').innerText = Number(data.near || 0).toLocaleString();
        document.getElementById('modal-error').innerText = Number(data.error || 0).toLocaleString();

        var medalText = getSdvxMedalText(data.clear);
        document.getElementById('modal-medal').innerText = medalText;

        document.getElementById('score-detail-modal').classList.add('is-active');
        document.documentElement.classList.add('is-clipped');
      } catch(e) {
        console.error(e);
      }
    }

    function closeScoreModal() {
      var modal = document.getElementById('score-detail-modal');
      if (modal) modal.classList.remove('is-active');
      document.documentElement.classList.remove('is-clipped');
    }

    function getSdvxGradeText(score, rawGrade) {
      if (score >= 9900000) return 'S';
      if (score >= 9800000) return 'AAA+';
      if (score >= 9700000) return 'AAA';
      if (score >= 9500000) return 'AA+';
      if (score >= 9300000) return 'AA';
      if (score >= 9000000) return 'A+';
      if (score >= 8700000) return 'A';
      if (score >= 7500000) return 'B';
      if (score >= 6500000) return 'C';
      return 'D';
    }

    function getSdvxMedalText(clear) {
      var labels = ["NO DATA", "PLAYED", "EFFECTIVE CLEAR", "EXCESSIVE CLEAR", "MAXXIVE CLEAR", "ULTIMATE CHAIN", "PERFECT ULTIMATE CHAIN"];
      return labels[clear] || "PLAYED";
    }

