doctype html
html
  head
    meta(charset="utf-8")
    meta(http-equiv="X-UA-Compatible", content="ie=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
    title RyuNET - Login
    link(rel="stylesheet", href="/static/css/bulma.min.css")
    link(rel="stylesheet", href="/static/css/margin.min.css")
    link(rel="stylesheet", href="/static/css/materialdesignicons.min.css")
    link(rel="stylesheet", href="/static/css/style.css")
    link(rel="stylesheet", href="/static/css/bulma-fix.css")
    link(rel="stylesheet", href="/static/css/modern.css")
  body.auth-body
    .auth-container
      .card.auth-card
        .card-content
          .has-text-centered.mb-5
            .image.is-64x64.logo.auth-logo
              img(src="/static/img/logo.png")
            h1.title.is-4.auth-title RyuNET
          if error
            .notification.is-danger.is-light.mb-4 #{error}
          form(method="post" action="/login")
            .field
              label.label Username
              .control.has-icons-left
                input.input(type="text" name="username" placeholder="Username" required autofocus)
                span.icon.is-small.is-left
                  i.mdi.mdi-account
            .field
              label.label Password
              .control.has-icons-left
                input.input(type="password" name="password" placeholder="Password" required)
                span.icon.is-small.is-left
                  i.mdi.mdi-lock
            .field
              button.button.is-info.is-fullwidth(type="submit")
                span.icon
                  i.mdi.mdi-login
                span Login
          hr
          if config.discord_client_id
            .has-text-centered.mb-4
              a.button.is-link.is-fullwidth(href="/auth/discord?action=login" style="background-color: #5865F2;")
                span.icon
                  i.mdi.mdi-discord
                span Log in with Discord
          .has-text-centered
            p.is-size-7.has-text-grey
              | Already have a game profile but no WebUI account?&nbsp;
              a(href="/signup") Sign up here
            if config.discord_client_id
              p.is-size-7.has-text-grey.mt-2
                | New and don't have a game profile yet?&nbsp;
                a(href="/auth/discord?action=register" style="color: #5865F2;") Create an account with Discord
            else
              p.is-size-7.has-text-grey.mt-2
                a(href="https://discord.gg/R6xUSKSykQ" target="_blank")
                  span.icon.is-small
                    i.mdi.mdi-discord
                  span  Join our Discord community
