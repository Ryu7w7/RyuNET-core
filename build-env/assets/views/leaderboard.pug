extends _layout.pug

block content
  style.
    .tier-lustrous { background: linear-gradient(90deg, #ff8a00, #e52e71, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 900 !important; }
    .tier-radiant { color: #55ffff !important; font-weight: 800 !important; text-shadow: 0 0 8px rgba(85,255,255,0.4); }
    .tier-rhodium { color: #ff99cc !important; font-weight: 800 !important; }
    .tier-platinum { color: #00e5ff !important; font-weight: 800 !important; }
    .tier-gold { color: #ffd700 !important; font-weight: 700 !important; }
    .tier-silver { color: #c0c0c0 !important; font-weight: 600 !important; }
    .tier-bronze { color: #cd7f32 !important; font-weight: 600 !important; }
    .tier-iron { color: #a19d94 !important; font-weight: 600 !important; }

  - const getRankTier = (rank, total) => {
  -   if (!rank || !total) return '';
  -   if (rank <= 3) return 'tier-lustrous';
  -   if (rank <= 10) return 'tier-radiant';
  -   if (rank <= 25) return 'tier-rhodium';
  -   if (rank <= 50) return 'tier-platinum';
  -   const pct = rank / total;
  -   if (pct <= 0.20) return 'tier-gold';
  -   if (pct <= 0.40) return 'tier-silver';
  -   if (pct <= 0.70) return 'tier-bronze';
  -   return 'tier-iron';
  - }

  section.section.is-main-section
    .box(style="position: relative; z-index: 100;")
      h2.title.is-4 Global Leaderboard
      .level.is-mobile.mt-3.mb-3(style="overflow: visible;")
        .level-left
          .level-item
            - const c_val = selectedCountry || 'all'
            - const sq_val = searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''
            - const co_val = (c_val && c_val !== 'all') ? `&country=${c_val}` : ''
            .tabs.is-toggle.is-toggle-rounded.m-0
              ul
                li(class=game=='sdvx' ? 'is-active' : '')
                  a(href=`/leaderboard?game=sdvx${sq_val}${co_val}`) SDVX
                li(class=game=='iidx' ? 'is-active' : '')
                  a(href=`/leaderboard?game=iidx&style=sp${sq_val}${co_val}`) IIDX
                li(class=game=='ddr' ? 'is-active' : '')
                  a(href=`/leaderboard?game=ddr&style=sp${sq_val}${co_val}`) DDR
                li(class=game=='popn' ? 'is-active' : '')
                  a(href=`/leaderboard?game=popn&style=class${sq_val}${co_val}`) POP'N
        .level-right
          .level-item
            form(method="GET" action="/leaderboard" style="margin: 0;")
              input(type="hidden" name="game" value=game)
              if game == 'iidx' || game == 'ddr' || game == 'popn'
                - var s_val = (typeof style === 'string' && style) ? style : (game === 'popn' ? 'class' : 'sp')
                input(type="hidden" name="style" value=s_val)
              .field.has-addons.m-0
                .control
                  input#country-input(type="hidden" name="country" value=c_val)
                  .dropdown.is-hoverable.is-right(style="z-index: 50;")
                    .dropdown-trigger
                      button.button.is-rounded(type="button" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: var(--text);")
                        span.icon
                          if c_val === 'all'
                            | 🌎
                          else
                            span.fi(class=`fi-${c_val}`)
                        span.ml-1 #{c_val === 'all' ? 'All' : c_val.toUpperCase()}
                        span.icon.is-small
                          i.mdi.mdi-chevron-down
                    .dropdown-menu#dropdown-menu(role="menu")
                      .dropdown-content(style="max-height: 300px; overflow-y: auto; background: #1a1f2c; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 8px 16px rgba(0,0,0,0.5);")
                        - const styleParam = (game === 'sdvx') ? '' : `&style=${style || (game === 'popn' ? 'class' : 'sp')}`
                        a.dropdown-item(href=`/leaderboard?game=${game}${styleParam}${sq_val}&country=all` style="color: var(--text);")
                          span.icon 🌎
                          |  All Countries
                        each co in availableCountries
                          if co.code !== 'xx'
                            a.dropdown-item(href=`/leaderboard?game=${game}${styleParam}${sq_val}&country=${co.code}` style="color: var(--text);")
                              span.icon
                                span.fi(class=`fi-${co.code}`)
                              |  #{co.code.toUpperCase()}
                .control
                  input.input.is-rounded(type="text" placeholder="Search player..." name="search" value=searchQuery || '')
                .control
                  button.button.is-info.is-rounded(type="submit")
                    span.icon: i.mdi.mdi-magnify

      if game == 'iidx'
        - const s = (typeof style === 'string' && style) ? style : 'sp'
        - const cq_val = (selectedCountry && selectedCountry !== 'all') ? `&country=${selectedCountry}` : ''
        .tabs.is-small.is-toggle.is-toggle-rounded.mt-2
          ul
            li(class=s=='sp' ? 'is-active' : '')
              a(href=`/leaderboard?game=iidx&style=sp${sq_val}${cq_val}`) SP
            li(class=s=='dp' ? 'is-active' : '')
              a(href=`/leaderboard?game=iidx&style=dp${sq_val}${cq_val}`) DP
      else if game == 'ddr'
        - const s = (typeof style === 'string' && style) ? style : 'sp'
        - const cq_val = (selectedCountry && selectedCountry !== 'all') ? `&country=${selectedCountry}` : ''
        .tabs.is-small.is-toggle.is-toggle-rounded.mt-2
          ul
            li(class=s=='sp' ? 'is-active' : '')
              a(href=`/leaderboard?game=ddr&style=sp${sq_val}${cq_val}`) SINGLE (SP)
            li(class=s=='dp' ? 'is-active' : '')
              a(href=`/leaderboard?game=ddr&style=dp${sq_val}${cq_val}`) DOUBLE (DP)
      else if game == 'popn'
        - const s = (typeof style === 'string' && style) ? style : 'class'
        - const cq_val = (selectedCountry && selectedCountry !== 'all') ? `&country=${selectedCountry}` : ''
        .tabs.is-small.is-toggle.is-toggle-rounded.mt-2
          ul
            li(class=s=='class' ? 'is-active' : '')
              a(href=`/leaderboard?game=popn&style=class${sq_val}${cq_val}`) POP'N CLASS
            li(class=s=='score' ? 'is-active' : '')
              a(href=`/leaderboard?game=popn&style=score${sq_val}${cq_val}`) TOTAL SCORE
    if game == 'sdvx'
      .box
        h3.title.is-5 SOUND VOLTEX — VOLFORCE RANKING
        if myRank && myRow
          .notification.is-success
            b Global Ranking:
            |  ##{myRank} of #{globalTotalPlayers || totalPlayers}
            if myLocalRank && myLocalRank !== myRank
              br
              b Filtered Ranking: 
              | ##{myLocalRank} of #{totalPlayers}
            br
            | VOLFORCE: #{Number(myRow.value).toFixed(3)}
            |  — Charts: #{myRow.extraA}
            |  — VF Class: #{myRow.className}
        else
          .notification
            | Not yet.
    else if game == 'iidx'
      .box
        if String(style).toLowerCase() == 'dp'
          h3.title.is-5 beatmania IIDX — DP EX SCORE RANKING
        else
          h3.title.is-5 beatmania IIDX — SP EX SCORE RANKING
        if myRank && myRow
          .notification.is-success
            b Global Ranking:
            |  ##{myRank} of #{globalTotalPlayers || totalPlayers}
            if myLocalRank && myLocalRank !== myRank
              br
              b Filtered Ranking: 
              | ##{myLocalRank} of #{totalPlayers}
            br
            | EX Score: #{Number(myRow.value).toLocaleString()} — Entries: #{myRow.extraA} — Mode: #{String(style).toUpperCase()}
        else
          .notification
            | Not yet.
    else if game == 'ddr'
      .box
        if String(style).toLowerCase() == 'dp'
          h3.title.is-5 DanceDanceRevolution — DP EX SCORE RANKING
        else
          h3.title.is-5 DanceDanceRevolution — SP EX SCORE RANKING
        if myRank && myRow
          .notification.is-success
            b Global Ranking:
            |  ##{myRank} of #{globalTotalPlayers || totalPlayers}
            if myLocalRank && myLocalRank !== myRank
              br
              b Filtered Ranking: 
              | ##{myLocalRank} of #{totalPlayers}
            br
            | EX Score: #{Number(myRow.value).toLocaleString()} — Charts: #{myRow.extraA} — Mode: #{String(style).toUpperCase()}
        else
          .notification
            | Not yet.
    else if game == 'popn'
      .box
        if String(style).toLowerCase() == 'score'
          h3.title.is-5 pop'n music — TOTAL SCORE RANKING
        else
          h3.title.is-5 pop'n music — POP'N CLASS RANKING
        if myRank && myRow
          .notification.is-success
            b Global Ranking:
            |  ##{myRank} of #{globalTotalPlayers || totalPlayers}
            if myLocalRank && myLocalRank !== myRank
              br
              b Filtered Ranking: 
              | ##{myLocalRank} of #{totalPlayers}
            br
            if String(style).toLowerCase() == 'score'
              | Total Score: #{Number(myRow.value).toLocaleString()} — Charts: #{myRow.extraA} — Clears: #{myRow.extraB}
            else
              | POP'N CLASS: #{Number(myRow.value).toFixed(2)} — Charts: #{myRow.extraA} — Clears: #{myRow.extraB}
        else
          .notification
            | Not yet.
    if !rows || rows.length === 0
      .box
        p.has-text-grey-light No ranking data available yet.
    else
      .box
        - const currentPage = page || 1
        - const pp = perPage || 20
        - const tp = totalPages || 1
        - const defStyle = (game === 'popn' ? 'class' : 'sp')
        - const s2 = (typeof style === 'string' && style) ? style : defStyle
        - const sqStr = searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''
        - const coStr = (selectedCountry && selectedCountry !== 'all') ? `&country=${selectedCountry}` : ''
        - const baseQs = ((game === 'sdvx') ? 'game=sdvx' : `game=${game}&style=${s2}`) + sqStr + coStr
        
        - const maxPagesToShow = 5;
        - let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
        - let endPage = Math.min(tp, startPage + maxPagesToShow - 1);
        - if (endPage - startPage + 1 < maxPagesToShow) { startPage = Math.max(1, endPage - maxPagesToShow + 1); }
        
        if tp > 1
          .is-flex.is-justify-content-center.is-align-items-center.mt-4.mb-5(style="gap: 0.5rem; width: 100%; margin: 0 auto; flex-wrap: wrap;")
            if currentPage > 1
              a.button.is-info(href=`/leaderboard?${baseQs}&page=${currentPage - 1}` style="border-radius: 8px;")
                span.icon: i.mdi.mdi-chevron-left
            else
              button.button.is-info(disabled style="opacity: 0.5; cursor: default; border-radius: 8px;")
                span.icon: i.mdi.mdi-chevron-left

            if startPage > 1
              a.button(href=`/leaderboard?${baseQs}&page=1` style="border-radius: 8px;") 1
              if startPage > 2
                span(style="color: var(--muted); padding: 0 0.5rem;") ...
                
            - for (let p = startPage; p <= endPage; p++)
              if p === currentPage
                span.button.is-primary(style="border-radius: 8px; font-weight: bold; pointer-events: none;") #{p}
              else
                a.button(href=`/leaderboard?${baseQs}&page=${p}` style="border-radius: 8px;") #{p}
                
            if endPage < tp
              if endPage < tp - 1
                span(style="color: var(--muted); padding: 0 0.5rem;") ...
              a.button(href=`/leaderboard?${baseQs}&page=${tp}` style="border-radius: 8px;") #{tp}

            if currentPage < tp
              a.button.is-info(href=`/leaderboard?${baseQs}&page=${currentPage + 1}` style="border-radius: 8px;")
                span.icon: i.mdi.mdi-chevron-right
            else
              button.button.is-info(disabled style="opacity: 0.5; cursor: default; border-radius: 8px;")
                span.icon: i.mdi.mdi-chevron-right

        .table-container(style="max-height: 65vh; overflow-y: auto; border-radius: var(--radius); border: 1px solid var(--border); background: rgba(0,0,0,0.1);")
          table.table.is-fullwidth.is-hoverable.is-striped(style="margin-bottom: 0; table-layout: fixed;")
            thead
              tr
                th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Rank
                th(style="width: 35%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 1.5rem; text-align: left; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Player
                if game == 'sdvx'
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") VOLFORCE
                  th(style="width: 10%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Charts
                  th(style="width: 25%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 1.5rem; text-align: left; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") VF Class
                else if game == 'iidx'
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") EX Score
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Entries
                  th(style="width: 20%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 1.5rem; text-align: left; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Mode
                else if game == 'ddr'
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") EX Score
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Charts
                  th(style="width: 20%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 1.5rem; text-align: left; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Mode
                else if game == 'popn'
                  if String(style).toLowerCase() == 'score'
                    th(style="width: 20%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Total Score
                  else
                    th(style="width: 20%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") POP'N CLASS
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Charts
                  th(style="width: 15%; position: sticky; top: 0; background: rgba(12,16,28,0.95); backdrop-filter: blur(8px); z-index: 10; border-bottom: 2px solid rgba(255,255,255,0.1); color: var(--muted); padding: 1.2rem 0; text-align: center; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;") Clears
            tbody
              each r, i in rows
                - const isFiltered = (selectedCountry && selectedCountry !== 'all') || searchQuery
                - const rank = r.localRank || r.globalRank || (((currentPage - 1) * pp) + i + 1)
                tr
                  td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                    .is-flex.is-justify-content-center.is-align-items-center
                      span(style="display: inline-block; width: 28px; text-align: right;")
                        if rank === 1
                          span(title="1st Place") 🥇
                        else if rank === 2
                          span(title="2nd Place") 🥈
                        else if rank === 3
                          span(title="3rd Place") 🥉
                      strong(style="display: inline-block; width: 44px; text-align: left; margin-left: 6px; font-size: 1.15rem;" class=getRankTier(rank, isFiltered ? totalPlayers : globalTotalPlayers)) ##{rank}
                      if isFiltered && r.globalRank
                        div(style="font-size: 0.75rem; color: var(--muted); margin-top: 2px;" class=getRankTier(r.globalRank, globalTotalPlayers)) (Global ##{r.globalRank})

                  td(style="vertical-align: middle; padding: 0.6rem 1.5rem; text-align: left;")
                    a(href=`/profile/${r.refid}` style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;")
                      .lb-avatar(style="width:36px; height:36px; border-radius:8px; overflow:hidden; flex-shrink:0; background:#222; border: 2px solid rgba(255,255,255,0.1);")
                        if r.avatarUrl
                          img(src=`/uploads/${r.avatarUrl}` style="width:100%; height:100%; object-fit:cover;")
                        else
                          img(src="/static/img/avatar.jpg" style="width:100%; height:100%; object-fit:cover;")
                      .is-flex.is-align-items-center
                        if r.countryCode && r.countryCode !== 'xx'
                          span.fi(class="fi-" + r.countryCode style="margin-right: 0.5rem; font-size:1rem; border-radius:2px;")
                        else
                          span(style="margin-right: 0.5rem; font-size:1.1rem;") 🌎
                        strong(style="font-size: 1.1rem; letter-spacing: 0.5px;" class=getRankTier(rank, isFiltered ? totalPlayers : globalTotalPlayers)) #{r.name}

                  if game == 'sdvx'
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                      span.tag.is-primary.is-light(style="font-family: monospace; font-size: 1.1rem; font-weight: bold;") #{Number(r.value).toFixed(3)}
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                      span(style="font-weight: 600; font-size: 1.1rem;") #{r.extraA}
                    td(style="vertical-align: middle; padding: 1rem 1.5rem; text-align: left;")
                      .is-flex.is-align-items-center.is-justify-content-flex-start(style="gap:.75rem;")
                        if r.classImg
                          img(src=r.classImg alt="" style="height:32px; width:auto; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));" onerror="this.style.display='none';")
                        span(style="font-weight: 700; color: var(--text); font-size: 1.05rem; letter-spacing: 0.5px;") #{r.className}

                  else if game == 'iidx'
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;") 
                      span.tag.is-info.is-light(style="font-family: monospace; font-size: 1.1rem; font-weight: bold;") #{Number(r.value).toLocaleString()}
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                      span(style="font-weight: 600; font-size: 1.1rem;") #{r.extraA}
                    td(style="vertical-align: middle; padding: 1rem 1.5rem; text-align: left;")
                      span.tag.is-dark.is-medium(style="font-weight: bold; letter-spacing: 1px;") #{String(style).toUpperCase()}

                  else if game == 'ddr'
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;") 
                      span.tag.is-warning.is-light(style="font-family: monospace; font-size: 1.1rem; font-weight: bold;") #{Number(r.value).toLocaleString()}
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                      span(style="font-weight: 600; font-size: 1.1rem;") #{r.extraA}
                    td(style="vertical-align: middle; padding: 1rem 1.5rem; text-align: left;")
                      span.tag.is-dark.is-medium(style="font-weight: bold; letter-spacing: 1px;") #{String(style).toUpperCase()}

                  else if game == 'popn'
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;") 
                      if String(style).toLowerCase() == 'score'
                        span.tag.is-info.is-light(style="font-family: monospace; font-size: 1.1rem; font-weight: bold;") #{Number(r.value).toLocaleString()}
                      else
                        span.tag.is-primary.is-light(style="font-family: monospace; font-size: 1.1rem; font-weight: bold;") #{Number(r.value).toFixed(2)}
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                      span(style="font-weight: 600; font-size: 1.1rem;") #{r.extraA}
                    td(style="vertical-align: middle; padding: 1rem 0; text-align: center;")
                      span.tag.is-success.is-light(style="font-family: monospace; font-size: 1.05rem; font-weight: bold;") #{r.extraB}